local function switchTab(tab)
    _G.BloodHack.CurrentTab = tab
    MainFrame.Visible = (tab == "Main")
    VisualFrame.Visible = (tab == "Visual")
    game:GetService("TweenService"):Create(MainTab, TweenInfo.new(0.2), {BackgroundColor3 = (tab == "Main") and Color3.fromRGB(110, 60, 255) or Color3.fromRGB(25, 25, 28), TextColor3 = (tab == "Main") and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(160, 160, 165)}):Play()
    game:GetService("TweenService"):Create(VisualTab, TweenInfo.new(0.2), {BackgroundColor3 = (tab == "Visual") and Color3.fromRGB(110, 60, 255) or Color3.fromRGB(25, 25, 28), TextColor3 = (tab == "Visual") and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(160, 160, 165)}):Play()
end

