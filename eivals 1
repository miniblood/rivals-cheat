    _G.BloodHack.ESPEnabled, _G.BloodHack.VisualFrame, function(v)
    _G.BloodHack.ESPEnabled = v
    if not v then 
        for p, _ in pairs(_G.BloodHack.ESP_Cache) do 
            _G.BloodHack.removeDrawingESP(p) 
        end 
    end
end)

