--// Input Handling (Toggle Menu and Aim Hold)
UIS.InputBegan:Connect(function(input, gpe)
    if gpe then return end
    if input.KeyCode == _G.BloodHack.TOGGLE_KEY then
        _G.BloodHack.MenuVisible = not _G.BloodHack.MenuVisible
        mp.Visible = _G.BloodHack.MenuVisible
    end
    if input.KeyCode == _G.BloodHack.AIM_KEY then
        _G.BloodHack.Holding = true
    end
end)

UIS.InputEnded:Connect(function(input)
    if input.KeyCode == _G.BloodHack.AIM_KEY then
        _G.BloodHack.Holding = false
    end
end)

--// Main Loop (Aimbot, Triggerbot, ESP, FOV Position)
RS.RenderStepped:Connect(function()
    local mouseLocation = UIS:GetMouseLocation()
    circle.Position = mouseLocation

    -- Aimbot Logic
    if _G.BloodHack.AimbotEnabled and _G.BloodHack.Holding then
        local target = _G.BloodHack.getClosestPlayer()
        if target and target.Character then
            local part = target.Character:FindFirstChild(_G.BloodHack.TARGET_PART)
            if part then
                local pos = Camera:WorldToViewportPoint(part.Position)
                mousemoverel((pos.X - mouseLocation.X) / _G.BloodHack.SMOOTHNESS, (pos.Y - mouseLocation.Y) / _G.BloodHack.SMOOTHNESS)
            end
        end
    end

    -- Triggerbot Logic
    if _G.BloodHack.TriggerbotEnabled then
        local mousePos = UIS:GetMouseLocation()
        local ray = Camera:ViewportPointToRay(mousePos.X, mousePos.Y)
        local raycastResult = workspace:Raycast(ray.Origin, ray.Direction * 1000)
        
        if raycastResult and raycastResult.Instance then
            local model = raycastResult.Instance:FindFirstAncestorOfClass("Model")
            if model then
                local player = Players:GetPlayerFromCharacter(model)
                if player and player ~= LocalPlayer and (player.Team ~= LocalPlayer.Team or player.Team == nil) then
                    local humanoid = model:FindFirstChildOfClass("Humanoid")
                    if humanoid and humanoid.Health > 0 then
                        mouse1click()
                    end
                endend
end
end
