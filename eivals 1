local function getClosestPlayer()
    if not AimbotEnabled and not TriggerbotEnabled then return nil end
    local closest, shortDist = nil, FOV_RADIUS
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") and (p.Team ~= LocalPlayer.Team or not p.Team) then
            local hum = p.Character:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 and p.Character:FindFirstChild(TARGET_PART) then
                local pos, onScreen = Camera:WorldToViewportPoint(p.Character[TARGET_PART].Position)
                if onScreen then
                    local dist = (Vector2.new(pos.X, pos.Y) - UserInputService:GetMouseLocation()).Magnitude
                    if dist < shortDist then shortDist, closest = dist, p end
                end
            end
        end
    end
    return closest
end

