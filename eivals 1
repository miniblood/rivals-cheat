local ESP_Cache = {}
local function removeDrawingESP(player)
    if ESP_Cache[player] then
        if ESP_Cache[player].Box then ESP_Cache[player].Box:Remove() end
        if ESP_Cache[player].Name then ESP_Cache[player].Name:Remove() end
        ESP_Cache[player] = nil
    end
end

