bh.createSwitch = function(name, pos, def, frame, cb)
    local r = bh.createMenuRow(name, pos, frame)
    local p = Instance.new("TextButton", r)
    p.Size, p.Position = UDim2.new(0, 36, 0, 18), 
        UDim2.new(1, -48, 0.5, -9)
    p.BackgroundColor3, p.Text = def and 
        Color3.fromRGB(110,60,255) or 
        Color3.fromRGB(45, 45, 50), ""
    Instance.new("UICorner", p).CornerRadius = UDim.new(1, 0)
    
    local d = Instance.new("Frame", p)
    d.Size, d.Position = UDim2.new(0, 12, 0, 12), 
        def and UDim2.new(1, -15, 0.5, -6) or 
        UDim2.new(0, 3, 0.5, -6)
    d.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    Instance.new("UICorner", d).CornerRadius = UDim.new(1, 0)
    
    p.MouseButton1Click:Connect(function()
        def = not def
        TS:Create(p, TweenInfo.new(0.2), {
            BackgroundColor3 = def and 
                Color3.fromRGB(110,60,255) or 
                Color3.fromRGB(45, 45, 50)
        }):Play()
        TS:Create(d, TweenInfo.new(0.2), {
            Position = def and UDim2.new(1, -15, 0.5, -6) 
                or UDim2.new(0, 3, 0.5, -6)
        }):Play()
        cb(def)
    end)
end

bh.removeDrawingESP = function(p)
    local c = bh.ESP_Cache[p]
    if c then
        if c.Box then c.Box:Remove() end
        if c.Name then c.Name:Remove() end
        if c.Tracer then c.Tracer:Remove() end
        if c.HealthBar then c.HealthBar:Remove() end
        if c.Dist then c.Dist:Remove() end
        bh.ESP_Cache[p] = nil
    end
end
