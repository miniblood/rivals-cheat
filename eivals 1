local function setMenuVisible(visible)
    if shared.TweensActive then return end
    shared.TweensActive = true
    local tInfo = TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
    if visible then
        shared.MainPanel.Visible = true
        local sizeTween = game:GetService("TweenService"):Create(shared.MainPanel, tInfo, {Size = UDim2.new(0, 300, 0, 360), Position = UDim2.new(0.5, -150, 0.5, -180)})
        local alphaTween = game:GetService("TweenService"):Create(shared.CanvasGroup, tInfo, {GroupTransparency = 0})
        sizeTween:Play() alphaTween:Play() sizeTween.Completed:Wait()
    else
        local sizeTween = game:GetService("TweenService"):Create(shared.MainPanel, tInfo, {Size = UDim2.new(0, 0, 0, 0), Position = UDim2.new(0.5, 0, 0.5, 0)})
        local alphaTween = game:GetService("TweenService"):Create(shared.CanvasGroup, tInfo, {GroupTransparency = 1})
        sizeTween:Play() alphaTween:Play() sizeTween.Completed:Wait()
        shared.MainPanel.Visible = false
    end
    shared.TweensActive = false
end

game:GetService("UserInputService").InputBegan:Connect(function(i, p)
    if not p and i.KeyCode == shared.TOGGLE_KEY then
        shared.MenuVisible = not shared.MenuVisible
        setMenuVisible(shared.MenuVisible)
    end
end)

