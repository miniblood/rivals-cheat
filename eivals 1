local function createModernBtn(text, pos, isToggle)
    local btn = Instance.new("TextButton", Canvas)
    btn.Size = UDim2.new(0, 230, 0, 42)
    btn.Position = UDim2.new(0.5, -115, 0, pos)
    btn.Text = isToggle and "  "..text or text
    btn.BackgroundColor3 = Color3.fromRGB(22, 24, 30)
    btn.BackgroundTransparency = 1
    btn.TextColor3 = Color3.fromRGB(170, 175, 190)
    btn.TextTransparency = 1
    btn.Font = Enum.Font.GothamSemibold
    btn.TextSize = 13
    btn.TextXAlignment = isToggle and Enum.TextXAlignment.Left or Enum.TextXAlignment.Center
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 8)
    
    local s = Instance.new("UIStroke", btn)
    s.Thickness, s.Color, s.Transparency = 1, Color3.fromRGB(35, 38, 48), 1
    
    local ind = nil
    if isToggle then
        ind = Instance.new("Frame", btn)
        ind.Size = UDim2.new(0, 8, 0, 8)
        ind.Position = UDim2.new(1, -22, 0.5, -4)
        ind.BackgroundColor3 = Color3.fromRGB(255, 65, 65)
        ind.BackgroundTransparency = 1
        Instance.new("UICorner", ind).CornerRadius = UDim.new(1, 0)
    end
    return btn, ind
end

