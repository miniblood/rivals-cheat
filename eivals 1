--// Чистка ESP
local function clearESP(p)
    if p.Character then
        local b = p.Character:FindFirstChild("BH_3D")
        if b then b:Destroy() end
        if p.Character:FindFirstChild("Head") and p.Character.Head:FindFirstChild("BH_Gui") then
            p.Character.Head.BH_Gui:Destroy()
        end
    end
end

--// Поиск ближайшей цели
local function getTarget()
    local target, shortest = nil, _G.BH.Rad
    local mouse = UIS:GetMouseLocation()
    for _, p in pairs(Plrs:GetPlayers()) do
        if p ~= LP and p.Character and (p.Team ~= LP.Team or p.Team == nil) then
            local pt = p.Character:FindFirstChild(_G.BH.Part)
            local hum = p.Character:FindFirstChildOfClass("Humanoid")
            if pt and hum and hum.Health > 0 then
                local pos, screen = Cam:WorldToViewportPoint(pt.Position)
                if screen then
                    local dist = (Vector2.new(pos.X, pos.Y) - mouse).Magnitude
                    if dist < shortest then target, shortest = p, dist end
                end
            end
        end
    end
    return target
end

--// Отрисовка элементов ESP
local function drawESP(p)
    if p == LP or not p.Character or (p.Team == LP.Team and p.Team ~= nil) then return end
    local char = p.Character
    local root = char:WaitForChild("HumanoidRootPart", 3)
    local head = char:WaitForChild("Head", 3)
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not root or not head or not hum or hum.Health <= 0 then return end

    if not char:FindFirstChild("BH_3D") then
        local box = Instance.new("BoxHandleAdornment", char)
        box.Name, box.Size, box.AlwaysOnTop = "BH_3D", Vector3.new(4, 5.5, 4), true
        box.Color3, box.Transparency, box.Adornee = Color3.fromRGB(110,60,255), 0.75, root
    end

    if not head:FindFirstChild("BH_Gui") then
        local bb = Instance.new("BillboardGui", head)
        bb.Name, bb.Size, bb.AlwaysOnTop, bb.ExtentsOffset = "BH_Gui", UDim2.new(0,120,0,40), true, Vector3.new(0,3,0)

        local name = Instance.new("TextLabel", bb)
        name.Size, name.BackgroundTransparency, name.Text = UDim2.new(1,0,0,12), 1, p.Name
        name.TextColor3, name.Font, name.TextSize = Color3.fromRGB(255,255,255), Enum.Font.GothamBold, 11
        Instance.new("UIStroke", name).Color = Color3.fromRGB(0,0,0)

        local bg = Instance.new("Frame", bb)
        bg.Size, bg.Position, bg.BackgroundColor3, bg.BorderSizePixel = UDim2.new(0,60,0,4), UDim2.new(0.5,-30,0,16), Color3.fromRGB(30,30,35), 0

        local bar = Instance.new("Frame", bg)
        bar.Name, bar.BorderSizePixel, bar.BackgroundColor3 = "Bar", 0, Color3.fromRGB(0,255,130)
        bar.Size = UDim2.new(hum.Health / hum.MaxHealth, 0, 1, 0)
    else
        local bb = head.BH_Gui
        local bar = bb:FindFirstChild("Bar", true)
        if bar then
            TS:Create(bar, TweenInfo.new(0.1), {Size = UDim2.new(hum.Health / hum.MaxHealth, 0, 1, 0)}):Play()
            bar.BackgroundColor3 = Color3.fromHSV(hum.Health / hum.MaxHealth * 0.35, 0.9, 0.9)
        end
    end
end

