bh.setMenuVisible = function(v)
    if bh.TweensActive then return end
    bh.TweensActive = true
    local ti = TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
    if v then
        bh.MainPanel.Visible = true
        TS:Create(bh.MainPanel, ti, {Size = UDim2.new(0, 300, 0, 360), Position = UDim2.new(0.5, -150, 0.5, -180)}):Play()
        local a = TS:Create(bh.CanvasGroup, ti, {GroupTransparency = 0}) a:Play() a.Completed:Wait()
    else
        TS:Create(bh.MainPanel, ti, {Size = UDim2.new(0, 0, 0, 0), Position = UDim2.new(0.5, 0, 0.5, 0)}):Play()
        local a = TS:Create(bh.CanvasGroup, ti, {GroupTransparency = 1}) a:Play() a.Completed:Wait()
        bh.MainPanel.Visible = false
    end
    bh.TweensActive = false
end

