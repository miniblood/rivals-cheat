        local res = workspace:Raycast(r.Origin, r.Direction * 1000)
        if res and res.Instance then
            local model = res.Instance:FindFirstAncestorOfClass("Model")
            if model then
                local p = Players:GetPlayerFromCharacter(model)
                if p and p ~= LocalPlayer and (p.Team ~= LocalPlayer.Team or p.Team == nil) then
                    if mouse1click then mouse1click() task.wait(0.07) end
                end
            end
        end
    end

    if bh.ESPEnabled then
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character then
                local hrp = p.Character:FindFirstChild("HumanoidRootPart")
                local hum = p.Character:FindFirstChildOfClass("Humanoid")
                if hrp and hum and hum.Health > 0 and (p.Team ~= LocalPlayer.Team or p.Team == nil) then
                    if not bh.ESP_Cache[p] then
                        bh.ESP_Cache[p] = {Box = Drawing.new("Square"), Name = Drawing.new("Text"), Tracer = Drawing.new("Line"), HealthBar = Drawing.new("Line"), Dist = Drawing.new("Text")}
                    end
                    local c = bh.ESP_Cache[p]
                    local vec, onScreen = Camera:WorldToViewportPoint(hrp.Position)
                    if onScreen then
                        local sx, sy = 2000 / vec.Z, 3000 / vec.Z
                        local bx, by = vec.X - sx/2, vec.Y - sy/2
                        local clr = bh.ESP_Color

                        c.Box.Size, c.Box.Position, c.Box.Color, c.Box.Thickness, c.Box.Visible = Vector2.new(sx, sy), Vector2.new(bx, by), clr, 1.5, true
                        c.Name.Text, c.Name.Size, c.Name.Position, c.Name.Color, c.Name.Outline, c.Name.Visible = p.Name, 14, Vector2.new(vec.X - c.Name.TextBounds.X / 2, by - 16), Color3.fromRGB(255, 255, 255), true, true

                        if bh.TracersEnabled then
                            c.Tracer.From, c.Tracer.To, c.Tracer.Color, c.Tracer.Thickness, c.Tracer.Visible = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y), Vector2.new(vec.X, vec.Y + (sy / 2)), clr, 1, true
                        else c.Tracer.Visible = false end

                        if bh.HealthEnabled then
                            local hpPct = hum.Health / hum.MaxHealth
                            c.HealthBar.From, c.HealthBar.To, c.HealthBar.Color, c.HealthBar.Thickness, c.HealthBar.Visible = Vector2.new(bx - 5, by + sy), Vector2.new(bx - 5, (by + sy) - (sy * hpPct)), Color3.fromHSV(hpPct * 0.33, 1, 1), 2.5, true
                        else c.HealthBar.Visible = false end

                        if bh.DistanceEnabled then
                            local myHrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                            local dMeters = myHrp and math.floor((hrp.Position - myHrp.Position).Magnitude) or 0
                            c.Dist.Text, c.Dist.Size, c.Dist.Position, c.Dist.Color, c.Dist.Outline, c.Dist.Visible = "[" .. tostring(dMeters) .. "m]", 13, Vector2.new(vec.X - c.Dist.TextBounds.X / 2, by + sy + 4), clr, true, true
                        else c.Dist.Visible = false end
                    else
