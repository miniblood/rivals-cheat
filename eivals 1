local function animateMenu(show)
    TweensActive = true
    local ease = TweenInfo.new(0.5, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
    if show then MainPanel.Visible = true end
    
    TweenService:Create(MainPanel, ease, {
        Position = show and UDim2.new(0.5, -130, 0.5, -175) or UDim2.new(0.5, -130, 0.5, 350), 
        BackgroundTransparency = show and 0 or 1
    }):Play()
    
    TweenService:Create(Header, ease, {BackgroundTransparency = show and 0 or 1}):Play()
    TweenService:Create(HeaderFix, ease, {BackgroundTransparency = show and 0 or 1}):Play()
    TweenService:Create(UIStroke, ease, {Transparency = show and 0 or 1}):Play()
    TweenService:Create(Title, ease, {TextTransparency = show and 0 or 1}):Play()
    TweenService:Create(FooterHint, ease, {TextTransparency = show and 0 or 1}):Play()
    TweenService:Create(MenuBlur, ease, {Size = show and 8 or 0}):Play()
    
    for _, b in pairs({AimBtn, TriggerBtn, EspBtn, SmoothBtn}) do
        TweenService:Create(b, ease, {BackgroundTransparency = show and 0 or 1, TextTransparency = show and 0 or 1}):Play()
        if b:FindFirstChild("UIStroke") then TweenService:Create(b.UIStroke, ease, {Transparency = show and 0 or 1}):Play() end
        local i = b:FindFirstChild("Frame")
        if i then TweenService:Create(i, ease, {BackgroundTransparency = show and 0 or 1}):Play() end
    end
    task.wait(0.5)
    if not show then MainPanel.Visible = false end
    TweensActive = false
end

task.spawn(function() animateMenu(true) end)

