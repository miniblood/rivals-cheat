_G.BloodHack.removeDrawingESP = function(p)
    local c = _G.BloodHack.ESP_Cache[p]
    if c then
        if c.Box then c.Box:Remove() end
        if c.Name then c.Name:Remove() end
        if c.Tracer then c.Tracer:Remove() end
        if c.HealthBar then c.HealthBar:Remove() end
        if c.Dist then c.Dist:Remove() end
        _G.BloodHack.ESP_Cache[p] = nil
    end
end

_G.BloodHack.createSwitch("Show Wallhack ESP+", 0, 
    _G.BloodHack.ESPEnabled, _G.BloodHack.VisualFrame, function(v)
    _G.BloodHack.ESPEnabled = v
    if not v then 
        for p, _ in pairs(_G.BloodHack.ESP_Cache) do 
            _G.BloodHack.removeDrawingESP(p) 
        end 
    end
end)

_G.BloodHack.setMenuVisible = function(visible)
    if _G.BloodHack.TweensActive then return end
    _G.BloodHack.TweensActive = true
    local ti = TweenInfo.new(0.3, Enum.EasingStyle.Quart, 
        Enum.EasingDirection.Out)
    
    if visible then
        _G.BloodHack.MainPanel.Visible = true
        TS:Create(_G.BloodHack.MainPanel, ti, {
            Size = UDim2.new(0, 300, 0, 360), 
            Position = UDim2.new(0.5, -150, 0.5, -180)
        }):Play()
        local a = TS:Create(_G.BloodHack.CanvasGroup, ti, {
            GroupTransparency = 0
        })
        a:Play() a.Completed:Wait()
    else
        TS:Create(_G.BloodHack.MainPanel, ti, {
            Size = UDim2.new(0, 0, 0, 0), 
            Position = UDim2.new(0.5, 0, 0.5, 0)
        }):Play()
        local a = TS:Create(_G.BloodHack.CanvasGroup, ti, {
            GroupTransparency = 1
        })
        a:Play() a.Completed:Wait()
        _G.BloodHack.MainPanel.Visible = false
    end
    _G.BloodHack.TweensActive = false
end

UIS.InputBegan:Connect(function(i, p)
    if not p and i.KeyCode == _G.BloodHack.TOGGLE_KEY then
        _G.BloodHack.MenuVisible = not _G.BloodHack.MenuVisible
        _G.BloodHack.setMenuVisible(_G.BloodHack.MenuVisible)
    elseif i.KeyCode == _G.BloodHack.AIM_KEY then
        _G.BloodHack.Holding = true
    end
end)

UIS.InputEnded:Connect(function(i)
    if i.KeyCode == _G.BloodHack.AIM_KEY then
        _G.BloodHack.Holding = false
    end
end)
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local Camera = workspace.CurrentCamera
local UIS = game:GetService("UserInputService")
local RS = game:GetService("RunService")
_G.BloodHack = _G.BloodHack or {}

RS.RenderStepped:Connect(function()
    local mouse = UIS:GetMouseLocation()
    _G.BloodHack.FOVCircle.Position = mouse
    _G.BloodHack.FOVCircle.Radius = _G.BloodHack.FOV_RADIUS

    if _G.BloodHack.AimbotEnabled and _G.BloodHack.Holding 
       and _G.BloodHack.getClosestPlayer then
        local t = _G.BloodHack.getClosestPlayer()
        if t and t.Character then
            local part = t.Character:FindFirstChild(
                _G.BloodHack.TARGET_PART
            )
            if part then
                local pos, onScreen = 
                    Camera:WorldToViewportPoint(part.Position)
                if onScreen then
                    local move = (Vector2.new(pos.X, pos.Y) 
                                 - mouse) / _G.BloodHack.SMOOTHNESS
                    if mousemoverel then mousemoverel(move.X, move.Y) end
                end
            end
        end
    end

    if _G.BloodHack.TriggerbotEnabled then
        local r = Camera:ViewportPointToRay(mouse.X, mouse.Y)
        local res = workspace:Raycast(r.Origin, r.Direction * 1000)
        if res and res.Instance then
            local model = res.Instance:FindFirstAncestorOfClass("Model")
            if model then
                local p = Players:GetPlayerFromCharacter(model)
                if p and p ~= LocalPlayer and (p.Team ~= LocalPlayer.Team 
                   or p.Team == nil) then
                    if mouse1click then mouse1click() task.wait(0.07) end
                end
            end
        end
    end

    if _G.BloodHack.ESPEnabled then
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character then
                local hrp = p.Character:FindFirstChild("HumanoidRootPart")
                local hum = p.Character:FindFirstChildOfClass("Humanoid")
                if hrp and hum and hum.Health > 0 and 
                   (p.Team ~= LocalPlayer.Team or p.Team == nil) then
                    
                    if not _G.BloodHack.ESP_Cache[p] then
                        _G.BloodHack.ESP_Cache[p] = {
                            Box = Drawing.new("Square"),
                            Name = Drawing.new("Text"),
                            Tracer = Drawing.new("Line"),
                            HealthBar = Drawing.new("Line"),
                            Dist = Drawing.new("Text")
                        }
                    end

                    local c = _G.BloodHack.ESP_Cache[p]
                    local vec, onScreen = Camera:WorldToViewportPoint(hrp.Position)

                    if onScreen then
                        local sx, sy = 2000 / vec.Z, 3000 / vec.Z
                        local bx, by = vec.X - sx / 2, vec.Y - sy / 2

                        c.Box.Size = Vector2.new(sx, sy)
                        c.Box.Position = Vector2.new(bx, by)
                        c.Box.Color = Color3.fromRGB(255, 50, 50)
                        c.Box.Thickness = 1.5
                        c.Box.Visible = true

                        c.Name.Text = p.Name
                        c.Name.Size = 14
                        c.Name.Position = Vector2.new(vec.X - 
                            c.Name.TextBounds.X / 2, by - 16)
                        c.Name.Color = Color3.fromRGB(255, 255, 255)
                        c.Name.Outline = true
                        c.Name.Visible = true

                        c.Tracer.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                        c.Tracer.To = Vector2.new(vec.X, vec.Y + (sy / 2))
                        c.Tracer.Color = Color3.fromRGB(110, 60, 255)
                        c.Tracer.Thickness = 1
                        c.Tracer.Visible = true

                        local hpPct = hum.Health / hum.MaxHealth
                        local hBarY = sy * hpPct
                        c.HealthBar.From = Vector2.new(bx - 5, by + sy)
                        c.HealthBar.To = Vector2.new(bx - 5, (by + sy) - hBarY)
                        c.HealthBar.Color = Color3.fromHSV(hpPct * 0.33, 1, 1)
                        c.HealthBar.Thickness = 2.5
                        c.HealthBar.Visible = true

                        local myHrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                        local dMeters = myHrp and math.floor((hrp.Position - myHrp.Position).Magnitude) or 0
                        c.Dist.Text = "[" .. tostring(dMeters) .. "m]"
                        c.Dist.Size = 13
                        c.Dist.Position = Vector2.new(vec.X - c.Dist.TextBounds.X / 2, by + sy + 4)
                        c.Dist.Color = Color3.fromRGB(200, 200, 200)
                        c.Dist.Outline = true
                        c.Dist.Visible = true
                    else
                        c.Box.Visible = false c.Name.Visible = false
                        c.Tracer.Visible = false c.HealthBar.Visible = false
                        c.Dist.Visible = false
                    end
                else
                    _G.BloodHack.removeDrawingESP(p)
                end
            end
        end
    end
end)

_G.BloodHack.setMenuVisible(true)
