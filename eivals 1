local function setMenuVisible(visible)
    if _G.BloodHack.TweensActive then return end
    _G.BloodHack.TweensActive = true
    local tInfo = TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
    if visible then
        _G.BloodHack.MainPanel.Visible = true
        local sizeTween = game:GetService("TweenService"):Create(_G.BloodHack.MainPanel, tInfo, {Size = UDim2.new(0, 300, 0, 360), Position = UDim2.new(0.5, -150, 0.5, -180)})
        local alphaTween = game:GetService("TweenService"):Create(_G.BloodHack.CanvasGroup, tInfo, {GroupTransparency = 0})
        sizeTween:Play() alphaTween:Play() sizeTween.Completed:Wait()
    else
        local sizeTween = game:GetService("TweenService"):Create(_G.BloodHack.MainPanel, tInfo, {Size = UDim2.new(0, 0, 0, 0), Position = UDim2.new(0.5, 0, 0.5, 0)})
        local alphaTween = game:GetService("TweenService"):Create(_G.BloodHack.CanvasGroup, tInfo, {GroupTransparency = 1})
        sizeTween:Play() alphaTween:Play() sizeTween.Completed:Wait()
        _G.BloodHack.MainPanel.Visible = false
    end
    _G.BloodHack.TweensActive = false
end

game:GetService("UserInputService").InputBegan:Connect(function(i, p)
    if not p and i.KeyCode == _G.BloodHack.TOGGLE_KEY then
        _G.BloodHack.MenuVisible = not _G.BloodHack.MenuVisible
        setMenuVisible(_G.BloodHack.MenuVisible)
    end
end)

game:GetService("RunService").RenderStepped:Connect(function()
