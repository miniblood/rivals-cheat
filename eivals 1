_G.BloodHack.setMenuVisible = function(visible)
    if _G.BloodHack.TweensActive then return end
    _G.BloodHack.TweensActive = true
    local ti = TweenInfo.new(0.3, Enum.EasingStyle.Quart, 
        Enum.EasingDirection.Out)
    
    if visible then
        _G.BloodHack.MainPanel.Visible = true
        TS:Create(_G.BloodHack.MainPanel, ti, {
            Size = UDim2.new(0, 300, 0, 360), 
            Position = UDim2.new(0.5, -150, 0.5, -180)
        }):Play()
        local a = TS:Create(_G.BloodHack.CanvasGroup, ti, {
            GroupTransparency = 0
        })
        a:Play() a.Completed:Wait()
    else
        TS:Create(_G.BloodHack.MainPanel, ti, {
            Size = UDim2.new(0, 0, 0, 0), 
            Position = UDim2.new(0.5, 0, 0.5, 0)
        }):Play()
        local a = TS:Create(_G.BloodHack.CanvasGroup, ti, {
            GroupTransparency = 1
        })
        a:Play() a.Completed:Wait()
        _G.BloodHack.MainPanel.Visible = false
    end
    _G.BloodHack.TweensActive = false
end

UIS.InputBegan:Connect(function(i, p)
    if not p and i.KeyCode == _G.BloodHack.TOGGLE_KEY then
        _G.BloodHack.MenuVisible = not _G.BloodHack.MenuVisible
        _G.BloodHack.setMenuVisible(_G.BloodHack.MenuVisible)
    elseif i.KeyCode == _G.BloodHack.AIM_KEY then
        _G.BloodHack.Holding = true
    end
end)

