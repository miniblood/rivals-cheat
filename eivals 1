_G.BloodHack.removeDrawingESP = function(player)
    if _G.BloodHack.ESP_Cache[player] then
        if _G.BloodHack.ESP_Cache[player].Box then _G.BloodHack.ESP_Cache[player].Box:Remove() end
        if _G.BloodHack.ESP_Cache[player].Name then _G.BloodHack.ESP_Cache[player].Name:Remove() end
        _G.BloodHack.ESP_Cache[player] = nil
    end
end

