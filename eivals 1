-- Конструктор обычного свитча
local function createSwitch(text, y, def, cb)
    local r = Instance.new("Frame", mp)
    r.Size, r.Position, r.BackgroundColor3 = UDim2.new(1,-24,0,35), UDim2.new(0,12,0,y), Color3.fromRGB(22,22,26)
    Instance.new("UICorner", r).CornerRadius = UDim.new(0,6)
    Instance.new("UIStroke", r).Color = Color3.fromRGB(30,30,35)

    local lbl = Instance.new("TextLabel", r)
    lbl.Size, lbl.Position, lbl.Text = UDim2.new(1,-60,1,0), UDim2.new(0,10,0,0), text
    lbl.TextColor3, lbl.Font, lbl.TextSize, lbl.TextXAlignment = Color3.fromRGB(170,170,175), Enum.Font.GothamSemibold, 11, Enum.TextXAlignment.Left
    lbl.BackgroundTransparency = 1

    local btn = Instance.new("TextButton", r)
    btn.Size, btn.Position, btn.Text = UDim2.new(0,32,0,16), UDim2.new(1,-42,0.5,-8), ""
    btn.BackgroundColor3 = def and Color3.fromRGB(110,60,255) or Color3.fromRGB(45,45,50)
    Instance.new("UICorner", btn).CornerRadius = UDim.new(1,0)

    btn.MouseButton1Click:Connect(function()
        def = not def
        TS:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = def and Color3.fromRGB(110,60,255) or Color3.fromRGB(45,45,50)}):Play()
        cb(def)
    end)
end

-- Конструктор кнопок регулировки значений (FOV и Smooth)
local function createValueChanger(text, y, getVal, setVal, step)
    local r = Instance.new("Frame", mp)
    r.Size, r.Position, r.BackgroundColor3 = UDim2.new(1,-24,0,35), UDim2.new(0,12,0,y), Color3.fromRGB(22,22,26)
    Instance.new("UICorner", r).CornerRadius = UDim.new(0,6)
    Instance.new("UIStroke", r).Color = Color3.fromRGB(30,30,35)

    local lbl = Instance.new("TextLabel", r)
    lbl.Size, lbl.Position, lbl.Text = UDim2.new(0,130,1,0), UDim2.new(0,10,0,0), text .. ": " .. tostring(getVal())
    lbl.TextColor3, lbl.Font, lbl.TextSize, lbl.TextXAlignment = Color3.fromRGB(170,170,175), Enum.Font.GothamSemibold, 11, Enum.TextXAlignment.Left
    lbl.BackgroundTransparency = 1

    local function createBtn(txt, xOffset)
        local b = Instance.new("TextButton", r)
        b.Size, b.Position, b.Text = UDim2.new(0,22,0,22), UDim2.new(1, xOffset, 0.5, -11), txt
        b.BackgroundColor3, b.TextColor3, b.Font, b.TextSize = Color3.fromRGB(35,35,40), Color3.fromRGB(255,255,255), Enum.Font.GothamBold, 12
        Instance.new("UICorner", b).CornerRadius = UDim.new(0,4)
        return b
    end

    local minus = createBtn("-", -54)
    local plus = createBtn("+", -28)

    minus.MouseButton1Click:Connect(function()
        setVal(getVal() - step)
        lbl.Text = text .. ": " .. tostring(getVal())
    end)

    plus.MouseButton1Click:Connect(function()
        setVal(getVal() + step)
        lbl.Text = text .. ": " .. tostring(getVal())
    end)
end

--// Элементы меню
createSwitch("Aimbot (Hold E)", 40, _G.BH.Aim, function(v) _G.BH.Aim = v fov.Visible = v end)
createSwitch("Triggerbot", 80, _G.BH.Trig, function(v) _G.BH.Trig = v end)
createSwitch("Visuals (ESP)", 120, _G.BH.Esp, function(v) _G.BH.Esp = v if not v then for _,p in pairs(Plrs:GetPlayers()) do clearESP(p) end end end)

-- Регулятор FOV круга
createValueChanger("FOV Radius", 170, function() return _G.BH.Rad end, function(val)
    if val < 10 then val = 10 end
    if val > 600 then val = 600 end
    _G.BH.Rad = val
    fov.Radius = val
end, 20)

-- Регулятор плавности наводки (Smoothness)
createValueChanger("Aimbot Smooth", 210, function() return _G.BH.Smooth end, function(val)
    if val < 1 then val = 1 end -- Минимальное сглаживание (самый резкий аим)
    if val > 20 then val = 20 end -- Максимальная плавность
    _G.BH.Smooth = val
end, 1)

--// Ввод и Бинды
UIS.InputBegan:Connect(function(i, g)
    if g then return end
    if i.KeyCode == Enum.KeyCode.Insert then _G.BH.Visible = not _G.BH.Visible mp.Visible = _G.BH.Visible end
    if i.KeyCode == Enum.KeyCode.E then _G.BH.Hold = true end
end)
UIS.InputEnded:Connect(function(i) if i.KeyCode == Enum.KeyCode.E then _G.BH.Hold = false end end)

--// Основной Цикл (RenderStepped)
RS.RenderStepped:Connect(function()
    local mLoc = UIS:GetMouseLocation()
    fov.Position = mLoc

    if _G.BH.Aim and _G.BH.Hold then
        local t = getTarget()
        if t and t.Character and t.Character:FindFirstChild(_G.BH.Part) then
            local pos = Cam:WorldToViewportPoint(t.Character[_G.BH.Part].Position)
            mousemoverel((pos.X - mLoc.X) / _G.BH.Smooth, (pos.Y - mLoc.Y) / _G.BH.Smooth)
        end
    end

    if _G.BH.Trig then
        local ray = Cam:ViewportPointToRay(mLoc.X, mLoc.Y)
        local res = workspace:Raycast(ray.Origin, ray.Direction * 1000)
        if res and res.Instance then
            local mdl = res.Instance:FindFirstAncestorOfClass("Model")
            local p = mdl and Plrs:GetPlayerFromCharacter(mdl)
            if p and p ~= LP and (p.Team ~= LP.Team or p.Team == nil) then
                local h = mdl:FindFirstChildOfClass("Humanoid")
                if h and h.Health > 0 then mouse1click() end
            end
        end
    end

    for _, p in pairs(Plrs:GetPlayers()) do
        if _G.BH.Esp then drawESP(p) else clearESP(p) end
    end
end)

Plrs.PlayerRemoving:Connect(clearESP)
