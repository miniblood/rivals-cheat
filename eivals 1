shared.createMenuRow = function(name, heightPos, parentFrame)
    local row = Instance.new("Frame", parentFrame)
    row.Size = UDim2.new(1, 0, 0, 40)
    row.Position = UDim2.new(0, 0, 0, heightPos)
    row.BackgroundColor3 = Color3.fromRGB(22, 22, 26)
    row.BorderSizePixel = 0
    Instance.new("UICorner", row).CornerRadius = UDim.new(0, 6)
    local s = Instance.new("UIStroke", row) s.Color = Color3.fromRGB(32, 32, 38)
    
    local lbl = Instance.new("TextLabel", row)
    lbl.Size = UDim2.new(0, 150, 1, 0)
    lbl.Position = UDim2.new(0, 12, 0, 0)
    lbl.Text = name
    lbl.TextColor3 = Color3.fromRGB(180, 180, 185)
    lbl.Font = Enum.Font.GothamSemibold
    lbl.TextSize = 11
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.BackgroundTransparency = 1
    return row
end

shared.createSwitch = function(name, pos, default, parentFrame, callback)
    local row = shared.createMenuRow(name, pos, parentFrame)
    local pwr = Instance.new("TextButton", row)
    pwr.Size = UDim2.new(0, 36, 0, 18)
    pwr.Position = UDim2.new(1, -48, 0.5, -9)
    pwr.BackgroundColor3 = default and Color3.fromRGB(110, 60, 255) or Color3.fromRGB(45, 45, 50)
    pwr.Text = ""
    Instance.new("UICorner", pwr).CornerRadius = UDim.new(1, 0)
    
    local dot = Instance.new("Frame", pwr)
    dot.Size = UDim2.new(0, 12, 0, 12)
    dot.Position = default and UDim2.new(1, -15, 0.5, -6) or UDim2.new(0, 3, 0.5, -6)
    dot.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    Instance.new("UICorner", dot).CornerRadius = UDim.new(1, 0)
    
    pwr.MouseButton1Click:Connect(function()
        default = not default
        game:GetService("TweenService"):Create(pwr, TweenInfo.new(0.2), {BackgroundColor3 = default and Color3.fromRGB(110, 60, 255) or Color3.fromRGB(45, 45, 50)}):Play()
        game:GetService("TweenService"):Create(dot, TweenInfo.new(0.2), {Position = default and UDim2.new(1, -15, 0.5, -6) or UDim2.new(0, 3, 0.5, -6)}):Play()
        callback(default)
    end)
end
