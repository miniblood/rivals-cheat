--// Функция прорисовки неонового ESP
local function applyBeautifulESP(p)
    if p == LocalPlayer or not p.Character then return end
    if p.Team == LocalPlayer.Team and p.Team ~= nil then return end

    local char = p.Character
    local head = char:WaitForChild("Head", 5)
    local hum = char:WaitForChild("Humanoid", 5)
    if not head or not hum or hum.Health <= 0 then return end

    if not char:FindFirstChild("BloodHack_Highlight") then
        local hl = Instance.new("Highlight")
        hl.Name = "BloodHack_Highlight"
        hl.FillColor = Color3.fromRGB(110, 60, 255)
        hl.FillTransparency = 0.6
        hl.OutlineColor = Color3.fromRGB(160, 120, 255)
        hl.OutlineTransparency = 0.1
        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        hl.Parent = char
    end

    if head and not head:FindFirstChild("BloodHack_ESP") then
        local bb = Instance.new("BillboardGui")
        bb.Name = "BloodHack_ESP"
        bb.Size = UDim2.new(0, 120, 0, 45)
        bb.AlwaysOnTop = true
        bb.ExtentsOffset = Vector3.new(0, 2.5, 0)
        bb.Parent = head

        local nameLabel = Instance.new("TextLabel")
        nameLabel.Size = UDim2.new(1, 0, 0, 15)
        nameLabel.BackgroundTransparency = 1
        nameLabel.Text = p.Name
        nameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
        nameLabel.Font = Enum.Font.GothamBold
        nameLabel.TextSize = 12
        Instance.new("UIStroke", nameLabel).Color = Color3.fromRGB(0, 0, 0)
        nameLabel.Parent = bb

        local healthBg = Instance.new("Frame")
        healthBg.Size = UDim2.new(0, 70, 0, 5)
        healthBg.Position = UDim2.new(0.5, -35, 0, 20)
        healthBg.BackgroundColor3 = Color3.fromRGB(30, 30, 35)
        healthBg.BorderSizePixel = 0
        Instance.new("UICorner", healthBg).CornerRadius = UDim.new(1, 0)
        healthBg.Parent = bb

        local healthBar = Instance.new("Frame")
        healthBar.Name = "Bar"
        healthBar.Size = UDim2.new(hum.Health / hum.MaxHealth, 0, 1, 0)
        healthBar.BackgroundColor3 = Color3.fromRGB(0, 255, 130)
        healthBar.BorderSizePixel = 0
        Instance.new("UICorner", healthBar).CornerRadius = UDim.new(1, 0)
        healthBar.Parent = healthBg

        local hpLabel = Instance.new("TextLabel")
        hpLabel.Name = "HPText"
        hpLabel.Size = UDim2.new(1, 0, 0, 12)
        hpLabel.Position = UDim2.new(0, 0, 0, 28)
        hpLabel.BackgroundTransparency = 1
        hpLabel.Text = math.floor(hum.Health) .. " HP"
        hpLabel.TextColor3 = Color3.fromRGB(220, 220, 220)
        hpLabel.Font = Enum.Font.GothamSemibold
        hpLabel.TextSize = 10
        Instance.new("UIStroke", hpLabel).Color = Color3.fromRGB(0, 0, 0)
        hpLabel.Parent = bb
    else
        local bb = head:FindFirstChild("BloodHack_ESP")
        if bb then
            local bar = bb:FindFirstChild("Bar", true)
            local hpText = bb:FindFirstChild("HPText", true)
            if bar and hpText then
                TS:Create(bar, TweenInfo.new(0.1), {Size = UDim2.new(hum.Health / hum.MaxHealth, 0, 1, 0)}):Play()
                bar.BackgroundColor3 = Color3.fromHSV(hum.Health / hum.MaxHealth * 0.35, 0.9, 0.9)
                hpText.Text = math.floor(hum.Health) .. " HP"
            end
        end
    end
end

--// Обработка биндов клавиатуры
UIS.InputBegan:Connect(function(input, gpe)
    if gpe then return end
    if input.KeyCode == _G.BloodHack.TOGGLE_KEY then
        _G.BloodHack.MenuVisible = not _G.BloodHack.MenuVisible
        _G.BloodHack.MainPanel.Visible = _G.BloodHack.MenuVisible
    end
    if input.KeyCode == _G.BloodHack.AIM_KEY then _G.BloodHack.Holding = true end
end)

UIS.InputEnded:Connect(function(input)
    if input.KeyCode == _G.BloodHack.AIM_KEY then _G.BloodHack.Holding = false end
end)

--// Главный рабочий цикл скрипта
RS.RenderStepped:Connect(function()
    local mouseLocation = UIS:GetMouseLocation()
    circle.Position = mouseLocation

    if _G.BloodHack.AimbotEnabled and _G.BloodHack.Holding then
        local target = _G.BloodHack.getClosestPlayer()
        if target and target.Character then
            local part = target.Character:FindFirstChild(_G.BloodHack.TARGET_PART)
            if part then
                local pos = Camera:WorldToViewportPoint(part.Position)
                mousemoverel((pos.X - mouseLocation.X) / _G.BloodHack.SMOOTHNESS, (pos.Y - mouseLocation.Y) / _G.BloodHack.SMOOTHNESS)
            end
        end
    end

    if _G.BloodHack.TriggerbotEnabled then
        local mousePos = UIS:GetMouseLocation()
        local ray = Camera:ViewportPointToRay(mousePos.X, mousePos.Y)
        local raycastResult = workspace:Raycast(ray.Origin, ray.Direction * 1000)
        
        if raycastResult and raycastResult.Instance then
            local model = raycastResult.Instance:FindFirstAncestorOfClass("Model")
            if model then
                local player = Players:GetPlayerFromCharacter(model)
                if player and player ~= LocalPlayer and (player.Team ~= LocalPlayer.Team or player.Team == nil) then
                    local humanoid = model:FindFirstChildOfClass("Humanoid")
                    if humanoid and humanoid.Health > 0 then mouse1click() end
                end
            end
        end
    end

    if _G.BloodHack.ESPEnabled then
        for _, p in pairs(Players:GetPlayers()) do applyBeautifulESP(p) end
    end
end)

Players.PlayerRemoving:Connect(function(p) _G.BloodHack.removeDrawingESP(p) end)
