local function switchTab(tab)
    _G.BloodHack.CurrentTab = tab
    _G.BloodHack.MainFrame.Visible = (tab == "Main")
    _G.BloodHack.VisualFrame.Visible = (tab == "Visual")
    local c1 = (tab == "Main") and Color3.fromRGB(110,60,255) 
        or Color3.fromRGB(25,25,28)
    local c2 = (tab == "Visual") and Color3.fromRGB(110,60,255) 
        or Color3.fromRGB(25,25,28)
    TS:Create(mt, TweenInfo.new(0.2), {BackgroundColor3 = c1}):Play()
    TS:Create(vt, TweenInfo.new(0.2), {BackgroundColor3 = c2}):Play()
end

