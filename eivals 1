shared.removeDrawingESP = function(player)
    if shared.ESP_Cache[player] then
        if shared.ESP_Cache[player].Box then shared.ESP_Cache[player].Box:Remove() end
        if shared.ESP_Cache[player].Name then shared.ESP_Cache[player].Name:Remove() end
        shared.ESP_Cache[player] = nil
    end
end

