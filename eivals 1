RunService.RenderStepped:Connect(function()
    if FOVCircle.Visible then FOVCircle.Position = UserInputService:GetMouseLocation() end
    if AimbotEnabled and Holding then
        local t = getClosestPlayer()
        if t and t.Character and t.Character:FindFirstChild(TARGET_PART) then
            local pos, onScreen = Camera:WorldToViewportPoint(t.Character[TARGET_PART].Position)
            if onScreen and mousemoverel then
                local mPos = UserInputService:GetMouseLocation()
                mousemoverel((pos.X - mPos.X) / SMOOTHNESS, (pos.Y - mPos.Y) / SMOOTHNESS)
            end
        end
    end
end)

task.spawn(function()
    while true do
        task.wait()
        if TriggerbotEnabled then
            local mouseTarget = LocalPlayer:GetMouse().Target
            if mouseTarget and mouseTarget.Parent then
                local obj = mouseTarget.Parent
                local model = obj:IsA("Model") and obj or obj.Parent:IsA("Model") and obj.Parent
                if model and model:FindFirstChildOfClass("Humanoid") then
                    local player = Players:GetPlayerFromCharacter(model)
                    if player and player ~= LocalPlayer and (player.Team ~= LocalPlayer.Team or not player.Team) then
                        local humanoid = model:FindFirstChildOfClass("Humanoid")
                        if humanoid and humanoid.Health > 0 then
                            if mouse1click then mouse1click() task.wait(0.05) end
                        end
                    end
                end
            end
        end
    end
end)

-- Рендеринг бессмертного 2D ESP через системный оверлей Drawing
RunService.RenderStepped:Connect(function()
    if not ESPEnabled then return end
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character and (p.Team ~= LocalPlayer.Team or not p.Team) then
            local hum = p.Character:FindFirstChildOfClass("Humanoid")
            local hrp = p.Character:FindFirstChild("HumanoidRootPart")
            
            if hum and hum.Health > 0 and hrp then
                local charPos, onScreen = Camera:WorldToViewportPoint(hrp.Position)
                
                if onScreen then
                    createDrawingESP(p)
                    local cache = ESP_Cache[p]
                    
                    -- Вычисление размеров динамического 2D бокса на экране
                    local head = p.Character:FindFirstChild("Head")
                    local headPos = head and Camera:WorldToViewportPoint(head.Position) or charPos
                    local height = math.abs(headPos.Y - charPos.Y) * 3
                    local width = height / 1.6
                    
                    -- Настройка 2D рамки игрока
                    cache.Box.Visible = true
                    cache.Box.Size = Vector2.new(width, height)
                    cache.Box.Position = Vector2.new(charPos.X - width/2, charPos.Y - height/2)
                    cache.Box.Color = Color3.fromRGB(45, 45, 48) -- Строгий серый бокс
                    cache.Box.Thickness = 1.5
                    
                    -- Текстовый ник
                    cache.Name.Visible = true
                    cache.Name.Text = p.Name
                    cache.Name.Size = 14
                    cache.Name.Center = true
                    cache.Name.Outline = true
                    cache.Name.Color = Color3.fromRGB(240, 240, 240)
                    cache.Name.Position = Vector2.new(charPos.X, (charPos.Y - height/2) - 18)
                    
                    -- Задний фон полоски ХП
                    cache.HealthBg.Visible = true
                    cache.HealthBg.Size = Vector2.new(3, height)
                    cache.HealthBg.Position = Vector2.new((charPos.X - width/2) - 6, charPos.Y - height/2)
                    cache.HealthBg.Color = Color3.fromRGB(25, 25, 25)
                    cache.HealthBg.Filled = true
                    
                    -- Анимированная сине-черная полоска ХП
                    local healthRatio = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
                    cache.HealthBar.Visible = true
                    cache.HealthBar.Size = Vector2.new(3, height * healthRatio)
                    cache.HealthBar.Position = Vector2.new((charPos.X - width/2) - 6, (charPos.Y + height/2) - (height * healthRatio))
                    cache.HealthBar.Filled = true
                    
                    local wave = (math.sin(tick() * 4) + 1) / 2
                    cache.HealthBar.Color = Color3.fromRGB(0, 100, 255):Lerp(Color3.fromRGB(15, 15, 15), wave * (1 - healthRatio * 0.5))
                else
                    removeDrawingESP(p)
                end
            else
                removeDrawingESP(p)
            end
        else
            removeDrawingESP(p)
        end
    end
end)
